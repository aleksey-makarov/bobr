; Bobr remote repository filesystem file, repository format version 1.
;
; The complete CBOR value stored under f/<FsFileHash>. It uses deterministic
; CBOR and a definite-length payload byte string. Semantic constraints that
; cannot be expressed in CDDL are specified in FS_FILE.md.

bobr-repository-fs-file = [
    metadata: fs-file-metadata,
    payload: bstr,
]

fs-file-metadata = {
    "uid": uint32,
    "gid": uint32,
    "mode": mode,
    "compression": compression,
    "decoded_size": uint64,
}

compression = "identity" / "zstd"

mode = 0..4095
uint32 = 0..4294967295
uint64 = 0..18446744073709551615
